{
  "rb_acme_ocg": [
    {
      "id": "rule_rb_acme_ocg__3.1",
      "clauseId": "rb_acme_ocg__3.1",
      "title": "Block billing",
      "severity": "reject",
      "scope": "entry",
      "recordType": "time_entry",
      "violation": { "all": [
        { "field": "hours", "op": "gt", "value": 0.5 },
        { "field": "narrative", "op": "segment_count_gt", "value": 1 }
      ] },
      "message": "Entry combines multiple tasks and exceeds 0.5 hours (block billing)."
    },
    {
      "id": "rule_rb_acme_ocg__3.2",
      "clauseId": "rb_acme_ocg__3.2",
      "title": "Vague narratives",
      "severity": "reject",
      "scope": "entry",
      "recordType": "time_entry",
      "violation": { "any": [
        { "field": "narrative", "op": "word_count_lt", "value": 5 },
        { "field": "narrative", "op": "contains_any", "value": ["attention to", "work on file", "review documents"] }
      ] },
      "message": "Narrative is vague: under five words or uses a generic phrase without identifying the subject."
    },
    {
      "id": "rule_rb_acme_ocg__3.3",
      "clauseId": "rb_acme_ocg__3.3",
      "title": "Staffing",
      "severity": "warn",
      "scope": "group",
      "recordType": "time_entry",
      "when": { "any": [
        { "field": "activityCode", "op": "eq", "value": "A109" },
        { "field": "narrative", "op": "matches", "value": "deposition|meeting" }
      ] },
      "violation": { "groupBy": ["date"], "fn": "count_distinct", "field": "timekeeperId", "op": "gt", "value": 2 },
      "message": "More than two timekeepers billed for attending the same deposition or meeting on the same day."
    },
    {
      "id": "rule_rb_acme_ocg__3.4",
      "clauseId": "rb_acme_ocg__3.4",
      "title": "Travel",
      "severity": "reduce",
      "scope": "entry",
      "recordType": "time_entry",
      "when": { "any": [
        { "field": "activityCode", "op": "eq", "value": "A110" },
        { "field": "narrative", "op": "matches", "value": "non-working travel|travel time" }
      ] },
      "violation": { "field": "rate", "op": "gt", "value": 0 },
      "adjustment": { "type": "rate_factor", "factor": 0.5 },
      "message": "Non-working travel must be billed at 50% of the standard rate."
    },
    {
      "id": "rule_rb_acme_ocg__3.5",
      "clauseId": "rb_acme_ocg__3.5",
      "title": "Clerical tasks",
      "severity": "reject",
      "scope": "entry",
      "recordType": "time_entry",
      "violation": { "field": "narrative", "op": "matches", "value": "(filed|filing|copying|copied|photocopy|scheduling|organiz)" },
      "message": "Clerical work (filing, copying, scheduling, document organization) is not billable."
    },
    {
      "id": "rule_rb_acme_ocg__3.6",
      "clauseId": "rb_acme_ocg__3.6",
      "title": "Daily cap",
      "severity": "warn",
      "scope": "group",
      "recordType": "time_entry",
      "violation": { "groupBy": ["timekeeperId", "date"], "fn": "sum", "field": "hours", "op": "gt", "value": 10 },
      "message": "Timekeeper billed more than 10 hours on this matter in a single day."
    }
  ],
  "rb_uscis_h1b": [
    {
      "id": "rule_rb_uscis_h1b__4.1",
      "clauseId": "rb_uscis_h1b__4.1",
      "title": "Prevailing wage",
      "severity": "reject",
      "scope": "entry",
      "recordType": "h1b_petition",
      "violation": { "field": "offeredWage", "op": "lt_field", "value": "lcaPrevailingWage" },
      "message": "Offered wage is below the prevailing wage on the certified LCA."
    },
    {
      "id": "rule_rb_uscis_h1b__4.2",
      "clauseId": "rb_uscis_h1b__4.2",
      "title": "Worksite",
      "severity": "reject",
      "scope": "entry",
      "recordType": "h1b_petition",
      "violation": { "field": "worksiteZip", "op": "not_in_field", "value": "lcaWorksiteZips" },
      "message": "Worksite ZIP is not listed on the certified LCA."
    },
    {
      "id": "rule_rb_uscis_h1b__4.3",
      "clauseId": "rb_uscis_h1b__4.3",
      "title": "Filing window",
      "severity": "reject",
      "scope": "entry",
      "recordType": "h1b_petition",
      "violation": { "field": "daysBeforeStart", "op": "gt", "value": 180 },
      "message": "Petition filed more than 180 days before the requested start date."
    }
  ]
}
